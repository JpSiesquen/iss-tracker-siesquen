# Seguridad de la cadena de suministro
#
# Contexto: el gusano Shai-Hulud comprometió ~640 paquetes de npm en 2025.
# Se ejecutaba solo al instalar, robaba tokens de npm/GitHub/nube y con
# ellos publicaba versiones infectadas de los paquetes de la víctima.
# Detalle completo en la issue #24 y en CLAUDE.md.

# Instalar un paquete ejecuta sus scripts (preinstall/postinstall) por
# defecto. Ese es exactamente el vector del ataque, así que se desactiva.
#
# ⚠️ Algunos paquetes legítimos los necesitan para compilar binarios
# (esbuild, sharp). Si uno falla al instalar, se ejecuta puntualmente y a
# conciencia:  npm install <paquete> --ignore-scripts=false
ignore-scripts=true

# Guardar las versiones exactas, sin ^ ni ~.
#
# Con ^, un npm install puede traer una versión publicada hace diez
# minutos por un atacante. Con versión exacta, cada actualización es una
# decisión deliberada y no un efecto secundario.
save-exact=true
